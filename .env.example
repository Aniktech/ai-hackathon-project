# Add real values to .env.local on your machine. Never commit secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Optional pooled URL for serverless app traffic (Neon host includes -pooler).
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
DATA_IMPORT_TOKEN="generate-a-long-random-value"
CRON_SECRET="generate-another-long-random-value"
