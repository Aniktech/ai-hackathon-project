generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConfigurationSheet {
  RULES       @map("rules")
  MIN_DISPLAY @map("min_display")
  LEAD_TIMES  @map("lead_times")
}

model AreaManager {
  areaManagerId    String  @id @map("area_manager_id") @db.VarChar(32)
  name             String  @db.VarChar(160)
  city             String  @db.VarChar(120)
  maxAlertsPerWeek Int     @default(5) @map("max_alerts_per_week")
  stores           Store[]

  @@map("area_managers")
}

model Store {
  storeId            String              @id @map("store_id") @db.VarChar(32)
  city               String              @db.VarChar(120)
  state              String              @db.VarChar(120)
  zone               String              @db.VarChar(32)
  tier               String              @db.VarChar(16)
  sizeSqft           Int                 @map("size_sqft")
  stockCapacityUnits Int                 @map("stock_capacity_units")
  openedOn           DateTime            @map("opened_on") @db.Date
  areaManagerId      String              @map("area_manager_id") @db.VarChar(32)
  areaManager        AreaManager         @relation(fields: [areaManagerId], references: [areaManagerId], onDelete: Restrict)
  salespeople        Salesperson[]
  roster             RosterDaily[]
  footfall           FootfallDaily[]
  bills              Bill[]
  stockWeekly        StockWeekly[]
  flagshipProtected  FlagshipProtected[]

  @@index([areaManagerId])
  @@index([state, city, tier])
  @@map("stores")
}

model Item {
  skuId            String             @id @map("sku_id") @db.VarChar(64)
  styleId          String             @map("style_id") @db.VarChar(64)
  styleName        String             @map("style_name") @db.VarChar(240)
  category         String             @db.VarChar(80)
  size             String             @db.VarChar(32)
  mrp              Decimal            @db.Decimal(12, 2)
  costPrice        Decimal            @map("cost_price") @db.Decimal(12, 2)
  launchDate       DateTime           @map("launch_date") @db.Date
  isCoreStyle      Boolean            @map("is_core_style")
  isPackaging      Boolean            @map("is_packaging")
  billLines        BillLine[]
  stockSnapshots   StockSnapshot[]
  stockWeekly      StockWeekly[]
  warehouseInbound WarehouseInbound[]

  @@index([styleId])
  @@index([category, launchDate])
  @@map("items")
}

model Salesperson {
  salespersonId String        @id @map("salesperson_id") @db.VarChar(32)
  storeId       String        @map("store_id") @db.VarChar(32)
  name          String        @db.VarChar(160)
  joinDate      DateTime      @map("join_date") @db.Date
  store         Store         @relation(fields: [storeId], references: [storeId], onDelete: Restrict)
  roster        RosterDaily[]
  bills         Bill[]

  @@index([storeId, joinDate])
  @@map("salespeople")
}

model RosterDaily {
  date          DateTime    @db.Date
  storeId       String      @map("store_id") @db.VarChar(32)
  salespersonId String      @map("salesperson_id") @db.VarChar(32)
  status        String      @db.VarChar(24)
  store         Store       @relation(fields: [storeId], references: [storeId], onDelete: Restrict)
  salesperson   Salesperson @relation(fields: [salespersonId], references: [salespersonId], onDelete: Restrict)

  @@id([date, storeId, salespersonId])
  @@index([storeId, date, status])
  @@index([salespersonId, date])
  @@map("roster_daily")
}

model FootfallDaily {
  date     DateTime @db.Date
  storeId  String   @map("store_id") @db.VarChar(32)
  footfall Int
  store    Store    @relation(fields: [storeId], references: [storeId], onDelete: Restrict)

  @@id([date, storeId])
  @@map("footfall_daily")
}

model Bill {
  billId        String      @id @map("bill_id") @db.VarChar(64)
  billDate      DateTime    @map("bill_date") @db.Date
  storeId       String      @map("store_id") @db.VarChar(32)
  salespersonId String      @map("salesperson_id") @db.VarChar(32)
  customerId    String      @map("customer_id") @db.VarChar(128)
  store         Store       @relation(fields: [storeId], references: [storeId], onDelete: Restrict)
  salesperson   Salesperson @relation(fields: [salespersonId], references: [salespersonId], onDelete: Restrict)
  lines         BillLine[]

  @@index([storeId, billDate])
  @@index([salespersonId, billDate])
  @@index([customerId, billDate])
  @@map("bills")
}

model BillLine {
  billId       String  @map("bill_id") @db.VarChar(64)
  skuId        String  @map("sku_id") @db.VarChar(64)
  quantity     Int     @map("qty")
  mrp          Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @map("selling_price") @db.Decimal(12, 2)
  bill         Bill    @relation(fields: [billId], references: [billId], onDelete: Cascade)
  item         Item    @relation(fields: [skuId], references: [skuId], onDelete: Restrict)

  @@id([billId, skuId])
  @@index([skuId, billId])
  @@map("bill_lines")
}

model StockSnapshot {
  asOfDate              DateTime  @map("as_of_date") @db.Date
  locationId            String    @map("location_id") @db.VarChar(32)
  skuId                 String    @map("sku_id") @db.VarChar(64)
  onHand                Int       @map("on_hand")
  inTransit             Int       @map("in_transit")
  inTransitArrivesOn    DateTime? @map("in_transit_arrives_on") @db.Date
  oldestStockReceivedOn DateTime? @map("oldest_stock_received_on") @db.Date
  item                  Item      @relation(fields: [skuId], references: [skuId], onDelete: Restrict)

  @@id([asOfDate, locationId, skuId])
  @@index([locationId, skuId])
  @@map("stock_snapshot")
}

model StockWeekly {
  weekEnding    DateTime @map("week_ending") @db.Date
  storeId       String   @map("store_id") @db.VarChar(32)
  skuId         String   @map("sku_id") @db.VarChar(64)
  closingOnHand Int      @map("closing_on_hand")
  daysInStock   Int      @map("days_in_stock")
  store         Store    @relation(fields: [storeId], references: [storeId], onDelete: Restrict)
  item          Item     @relation(fields: [skuId], references: [skuId], onDelete: Restrict)

  @@id([weekEnding, storeId, skuId])
  @@index([storeId, weekEnding])
  @@index([skuId, weekEnding])
  @@map("stock_weekly")
}

model WarehouseInbound {
  id           Int      @id @default(autoincrement())
  expectedDate DateTime @map("expected_date") @db.Date
  skuId        String   @map("sku_id") @db.VarChar(64)
  quantity     Int      @map("qty")
  status       String   @db.VarChar(32)
  item         Item     @relation(fields: [skuId], references: [skuId], onDelete: Restrict)

  @@index([expectedDate, skuId])
  @@index([status, expectedDate])
  @@map("warehouse_inbound")
}

model Calendar {
  date          DateTime @db.Date
  state         String   @db.VarChar(120)
  festival      String?  @db.VarChar(160)
  isWeddingDate Boolean  @map("is_wedding_date")

  @@id([date, state])
  @@map("calendar")
}

// These three source tabs have rules/settings whose exact columns are not
// fully enumerated in the participant brief. Preserve rows losslessly until
// the actual workbook confirms their stable fields.
model ConfigurationRow {
  sheet     ConfigurationSheet
  rowNumber Int                @map("row_number")
  payload   Json               @db.JsonB

  @@id([sheet, rowNumber])
  @@map("configuration_rows")
}

model FlagshipProtected {
  storeId String @map("store_id") @db.VarChar(32)
  rank    Int
  styleId String @map("style_id") @db.VarChar(64)
  store   Store  @relation(fields: [storeId], references: [storeId], onDelete: Restrict)

  @@id([storeId, rank])
  @@unique([storeId, styleId])
  @@map("flagship_protected")
}
